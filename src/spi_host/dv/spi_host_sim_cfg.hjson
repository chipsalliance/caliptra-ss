{
  // Name of the sim cfg - typically same as the name of the DUT.
  name: spi_host

  // Top level dut name (sv module).
  dut: caliptra_ss_spi_host

  // Top level testbench name (sv module).
  tb: tb

  // Simulator used to sign off this block
  tool: vcs

  // Fusesoc core file used for building the file list.
  fusesoc_core: lowrisc:dv:spi_host_sim:1.0

  // Testplan hjson file.
  testplan: "{self_dir}/../data/spi_host_testplan.hjson"

  // RAL spec - used to generate the RAL model.
  ral_spec: "{self_dir}/../data/spi_host.hjson"

  // Import additional common sim cfg files.
  import_cfgs: [// Project wide common sim cfg file
                "{self_dir}/spi_host_common_sim_cfg.hjson",
                // Common CIP test lists
                "{proj_root}/third_party/caliptra-rtl/tools/dvsim/tests/csr_tests.hjson",
                "{proj_root}/third_party/caliptra-rtl/tools/dvsim/tests/intr_test.hjson"]

  // Add additional tops for simulation.
  sim_tops: ["tb"]

  build_opts: [
    "-cc /usr/bin/gcc",
    "-ld /usr/bin/g++",
    "-LDFLAGS -B/usr/bin",
    "-CFLAGS -B/usr/bin",
    "-pvalue+tb.dut.u_reg.u_prim_reg_we_check.u_caliptra_prim_onehot_check.EnableAlertTriggerSVA=0",
    "+incdir+{proj_root}/third_party/caliptra-rtl/src/caliptra_prim/rtl",
    "+incdir+{proj_root}/third_party/caliptra-rtl/src/integration/rtl",
    "+incdir+{proj_root}/third_party/caliptra-rtl/src/libs/rtl",
    "+incdir+{proj_root}/src/tlul/rtl",
    "+incdir+{proj_root}/third_party/caliptra-rtl/src/axi/rtl"
  ]

  // Coverage exclusion
  xcelium_cov_refine_files: ["{self_dir}/cov/spi_host_unr_excl.vRefine"]

  // Default iterations for all tests - each test entry can override this.
  reseed: 10

  // Default UVM test and seq class name.
  uvm_test: spi_host_base_test
  uvm_test_seq: spi_host_base_vseq

  run_opts: ["+ral_verbosity=UVM_HIGH",
             // Enable cdc instrumentation.
             "+cdc_instrumentation_enabled=1",
             "+disable_assert_final_checks=1",
             "-assert disable_hier=tb.dut.u_reg.u_prim_reg_we_check.u_caliptra_prim_onehot_check.AssertConnected_A"]

  // List of test specifications.
  tests: [
    {
      name: spi_host_smoke
      uvm_test_seq: spi_host_smoke_vseq
    }
    {
      name: spi_host_speed
      uvm_test_seq: spi_host_speed_vseq
    }
    {
      name: spi_host_upper_range_clkdiv
      uvm_test_seq: spi_host_upper_range_clkdiv_vseq
      reseed: 5
    }
    {
      name: spi_host_performance
      uvm_test_seq: spi_host_performance_vseq
    }
    {
      name: spi_host_sw_reset
      uvm_test_seq: spi_host_sw_reset_vseq
      run_opts: ["+test_timeout_ns=1_000_000_000"]
    }
    {
      name: spi_host_overflow_underflow
      uvm_test_seq: spi_host_overflow_underflow_vseq
      run_opts: ["+en_scb=0"]
    }
    {
      name: spi_host_error_cmd
      uvm_test_seq: spi_host_error_cmd_vseq
      run_opts: ["+en_scb=0"]
    }
    {
      name: spi_host_event
      uvm_test_seq: spi_host_event_vseq
      run_opts: ["+en_scb=0", "+test_timeout_ns=1_000_000_000"]
    }
    {
      name: spi_host_passthrough_mode
      uvm_test_seq: spi_host_passthrough_mode_vseq
      run_opts: ["+en_scb=0"]
    }
    {
      name: spi_host_status_stall
      uvm_test_seq: spi_host_status_stall_vseq
      run_opts: ["+test_timeout_ns=1_000_000_000"]
    }
    {
      name: spi_host_idlecsbactive
      uvm_test_seq: spi_host_idlecsbactive_vseq
    }
    {
      name: spi_host_stress_all
      uvm_test_seq: spi_host_stress_all_vseq
      run_opts: ["+test_timeout_ns=1_000_000_000"]
    }
    {
      name: spi_host_spien
      uvm_test_seq: spi_host_spien_vseq
    }
    {
      name: spi_host_flash
      uvm_test_seq: spi_host_smoke_vseq
    }
    {
      name: spi_host_dual_cs
      uvm_test_seq: spi_host_dual_cs_vseq
    }
  ]

  // List of regressions.
  regressions: [
    {
      name: smoke
      tests: ["spi_host_smoke"]
    }
    {
      name: all
      tests: [
        "spi_host_smoke",
        "spi_host_dual_cs",
        "spi_host_speed",
        "spi_host_upper_range_clkdiv",
        "spi_host_performance",
        "spi_host_sw_reset",
        "spi_host_overflow_underflow",
        "spi_host_error_cmd",
        "spi_host_event",
        "spi_host_passthrough_mode",
        "spi_host_status_stall",
        "spi_host_idlecsbactive",
        "spi_host_stress_all",
        "spi_host_spien",
        "spi_host_csr_hw_reset",
        "spi_host_csr_rw",
        "spi_host_csr_bit_bash",
        "spi_host_csr_aliasing",
        "spi_host_same_csr_outstanding",
        "spi_host_csr_mem_rw_with_rand_reset",
        "spi_host_intr_test"
      ]
    }
  ]

  overrides: [
    {
      name: default_vcs_cov_cfg_file
      value: "-cm_hier {self_dir}/../config/cov_hier.cfg"
    },
    {
      name: cover_reg_top_vcs_cov_cfg_file
      value: "-cm_hier {self_dir}/../config/cov_hier.cfg"
    },
    {
      name: vcs_build_opt_debug_region
      value: "-debug_access+all"
    },
    {
      name: vcs_build_opt_debug_access
      value: "-debug_access+all"
    }
  ]
}
