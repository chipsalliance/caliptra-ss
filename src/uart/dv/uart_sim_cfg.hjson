{
  // Name of the sim cfg - typically same as the name of the DUT.
  name: uart

  // Top level dut name (sv module).
  dut: uart

  // Top level testbench name (sv module).
  tb: tb

  // Simulator used to sign off this block
  tool: vcs

  // Fusesoc core file used for building the file list.
  fusesoc_core: lowrisc:dv:uart_sim:0.1

  sv_flist_gen_flags: ["--no-export"]



  // Testplan hjson file.
  testplan: "{proj_root}/src/uart/data/uart_testplan.hjson"

  // RAL spec - used to generate the RAL model.
  ral_spec: "{proj_root}/src/uart/data/uart.hjson"

  // Import additional common sim cfg files.
  import_cfgs: [// Project wide common sim cfg file
                "{proj_root}/tools/dvsim/common_sim_cfg.hjson",
                // Common CIP test lists
                "{proj_root}/tools/dvsim/tests/csr_tests.hjson",
                //"{proj_root}/tools/dvsim/tests/alert_test.hjson",
                "{proj_root}/tools/dvsim/tests/intr_test.hjson"]
                //"{proj_root}/tools/dvsim/tests/tl_access_tests.hjson",
                //"{proj_root}/tools/dvsim/tests/sec_cm_tests.hjson",
                //"{proj_root}/tools/dvsim/tests/stress_tests.hjson"]

  // Add additional tops for simulation.
  sim_tops: ["uart_bind"]

  // Default iterations for all tests - each test entry can override this.
  reseed: 50

  build_opts: [
    "+incdir+{proj_root}/third_party/caliptra-rtl/src/libs/rtl",
    "+incdir+{proj_root}/third_party/caliptra-rtl/src/caliptra_prim/rtl",
    "+incdir+{proj_root}/third_party/caliptra-rtl/src/caliptra_prim_generic/rtl",
    "+incdir+{proj_root}/third_party/caliptra-rtl/src/integration/rtl",
    "+incdir+{proj_root}/third_party/caliptra-rtl/src/axi/rtl",
    "+incdir+{proj_root}/src/tlul/rtl",
  ]

  // Enable cdc instrumentation.
  run_opts: ["+cdc_instrumentation_enabled=1"]

  // Default UVM test and seq class name.
  uvm_test: uart_base_test
  uvm_test_seq: uart_base_vseq

  // Add UART specific exclusion files.
  vcs_cov_excl_files: ["{proj_root}/src/uart/dv/cov/uart_cov_excl.el"]

  // List of test specifications.
  tests: [
    {
      name: uart_rx_break_err
      uvm_test_seq: uart_rx_break_err_vseq
    }

    {
      name: uart_reg_access_err
      uvm_test_seq: uart_reg_access_err_vseq
    }

    {
      name: uart_smoke
      uvm_test_seq: uart_smoke_vseq
    }

    {
      name: uart_tx_rx
      uvm_test_seq: uart_tx_rx_vseq
    }

    {
      name: uart_fifo_full
      uvm_test_seq: uart_fifo_full_vseq
    }

    {
      name: uart_fifo_overflow
      uvm_test_seq: uart_fifo_overflow_vseq
    }

    {
      name: uart_fifo_reset
      // need more seeds to cover uart_env_cov::rx_fifo_level_cg and uart_env_cov::tx_fifo_level_cg
      reseed: 300
      uvm_test_seq: uart_fifo_reset_vseq
    }

    {
      name: uart_rx_oversample
      uvm_test_seq: uart_rx_oversample_vseq
      run_opts: ["+zero_delays=1"]
    }

    {
      name: uart_intr
      uvm_test_seq: uart_intr_vseq
      // 3s
      run_opts: ["+test_timeout_ns=3000000000"]
    }

    {
      name: uart_noise_filter
      uvm_test_seq: uart_noise_filter_vseq
    }

    {
      name: uart_rx_start_bit_filter
      uvm_test_seq: uart_rx_start_bit_filter_vseq
    }

    {
      name: uart_rx_parity_err
      uvm_test_seq: uart_rx_parity_err_vseq
    }

    {
      name: uart_tx_ovrd
      uvm_test_seq: uart_tx_ovrd_vseq
    }

    {
      name: uart_loopback
      uvm_test_seq: uart_loopback_vseq
    }

    {
      name: uart_perf
      uvm_test_seq: uart_perf_vseq
      run_opts: ["+zero_delays=1"]
    }

    {
      name: uart_long_xfer_wo_dly
      uvm_test_seq: uart_long_xfer_wo_dly_vseq
      run_opts: ["+zero_delays=1"]
    }

    {
      name: uart_axi_toggle
      uvm_test_seq: uart_axi_toggle_vseq
    }

    {
      name: uart_sec_cm
      uvm_test_seq: uart_sec_cm_vseq
    }

    {
      name: uart_stress_all
      uvm_test_seq: uart_stress_all_vseq
    }

    {
      name: uart_stress_all_with_rand_reset
      // need more seeds to cover uart_agent_cov::uart_reset_cg
      reseed: 100
      // 3s
      run_opts: ["+test_timeout_ns=3000000000"]
      uvm_test_seq: uart_stress_all_with_rand_reset_vseq
    }
  ]

  // List of regressions.
  regressions: [
    {
      name: smoke
      tests: ["uart_smoke", "uart_axi_toggle"]
    }
  ]

  overrides: [
    {
      name: sv_flist_gen_opts
      value: [
        "--cores-root={build_dir}/cores",
        "--cores-root={proj_root}/src",
        "--cores-root={proj_root}/tools/dv-classes",
        "--cores-root={proj_root}/third_party/caliptra-rtl/tools/dv-classes",
        "run",
        "{sv_flist_gen_flags}",
        "--target=sim",
        "--work-root={sv_flist_gen_dir}",
        "--setup",
        "{fusesoc_core}",
      ]
    },
    {
      name: pre_build_cmds
      value: [
        "mkdir -p {build_dir}/cores",
        "true",
      ]
    }
  ]
}
