`ifndef CALIPTRA_SS_USB_HANDSHAKE_COUNTER_CALLBACK_SV
`define CALIPTRA_SS_USB_HANDSHAKE_COUNTER_CALLBACK_SV

// =============================================================================
// Link-monitor callback that counts device-sourced handshake packets
// (ACK / NAK / STALL) seen on the bus while its window is armed.
//
// It turns "the device must not respond at all" into a positively measured
// quantity. The VIP's own transfer-level timeout cannot be the verdict (a
// timeout is also what a hung testbench looks like), so a sequence arms this
// callback around the probe token and reads the handshake count back; for a
// no-response scenario the expected count is 0.
//
// Used by caliptra_ss_usb_hs_dev_unsupported_ep_sequence.
//
// Only RX packets are counted - in device-under-test mode the VIP is the host,
// so a handshake arriving on RX is by definition sourced by the DUT.
// =============================================================================

class caliptra_ss_usb_handshake_counter_callback
    extends svt_usb_link_monitor_callback;

    `uvm_object_utils(caliptra_ss_usb_handshake_counter_callback)

    // Window arm control. Counting is suppressed unless armed, so the
    // handshakes generated by hub/dev0 enumeration are never attributed to a
    // measured window.
    protected static bit          window_armed;
    protected static int unsigned ack_count;
    protected static int unsigned nak_count;
    protected static int unsigned stall_count;

    function new(string name = "caliptra_ss_usb_handshake_counter_callback");
        super.new(name);
    endfunction

    // Clear all counters and open the counting window.
    static function void arm_window();
        ack_count    = 0;
        nak_count    = 0;
        stall_count  = 0;
        window_armed = 1;
    endfunction

    // Close the counting window. Counters keep their values for inspection.
    static function void disarm_window();
        window_armed = 0;
    endfunction

    static function int unsigned get_ack_count();
        return ack_count;
    endfunction

    static function int unsigned get_nak_count();
        return nak_count;
    endfunction

    static function int unsigned get_stall_count();
        return stall_count;
    endfunction

    // Total device-sourced handshakes observed in the window.
    static function int unsigned get_handshake_count();
        return ack_count + nak_count + stall_count;
    endfunction

    virtual function void usb_20_rx_packet_ended(
        svt_usb_link_monitor link_mon,
        svt_usb_packet pkt);

        if (!window_armed) return;
        if (pkt == null)   return;
        if (pkt.pid_type != svt_usb_packet::HANDSHAKE) return;

        case (pkt.pid_name)
            svt_usb_packet::ACK   : ack_count++;
            svt_usb_packet::NAK   : nak_count++;
            svt_usb_packet::STALL : stall_count++;
            default: begin
                `uvm_error("USB_UNSUPPORTED_EP_RESPONSE",
                    $sformatf("Unexpected device handshake PID 0x%0h during the silence window.",
                              pkt.pid_name))
            end
        endcase
    endfunction

endclass

`endif // CALIPTRA_SS_USB_HANDSHAKE_COUNTER_CALLBACK_SV

