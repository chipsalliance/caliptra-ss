//
// Provisions and locks the secret hw_digest partitions exercised by
// smoke_test_fc_digest_read_dai_vs_csr so their HW digests are non-zero,
// content-derived values at boot. SECRET_PROD_PARTITION_3 (FIELD_ENTROPY_3) is
// deliberately left OUT so it stays unprovisioned/unlocked for the secret DAI
// access-lock check under debug intent.
//
{
    partitions: [
        {
            name: "SECRET_MANUF_PARTITION",
            lock: "True",
            items: [
                { name: "CPTRA_CORE_UDS_SEED", value: "0x0123456789abcdef" }
            ]
        },
        {
            name: "SECRET_PROD_PARTITION_0",
            lock: "True",
            items: [
                { name: "CPTRA_CORE_FIELD_ENTROPY_0", value: "0x1111111122222222" }
            ]
        },
        {
            name: "SECRET_PROD_PARTITION_1",
            lock: "True",
            items: [
                { name: "CPTRA_CORE_FIELD_ENTROPY_1", value: "0x3333333344444444" }
            ]
        },
        {
            name: "SECRET_PROD_PARTITION_2",
            lock: "True",
            items: [
                { name: "CPTRA_CORE_FIELD_ENTROPY_2", value: "0x5555555566666666" }
            ]
        },
        {
            name: "VENDOR_SECRET_PROD_PARTITION",
            lock: "True",
            items: [
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_0",  value: "0x0000000100000002" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_1",  value: "0x0000000300000004" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_2",  value: "0x0000000500000006" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_3",  value: "0x0000000700000008" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_4",  value: "0x000000090000000a" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_5",  value: "0x0000000b0000000c" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_6",  value: "0x0000000d0000000e" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_7",  value: "0x0000000f00000010" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_8",  value: "0x0000001100000012" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_9",  value: "0x0000001300000014" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_10", value: "0x0000001500000016" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_11", value: "0x0000001700000018" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_12", value: "0x000000190000001a" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_13", value: "0x0000001b0000001c" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_14", value: "0x0000001d0000001e" },
                { name: "CPTRA_SS_VENDOR_SPECIFIC_SECRET_FUSE_15", value: "0x0000001f00000020" }
            ]
        }
    ]
}
