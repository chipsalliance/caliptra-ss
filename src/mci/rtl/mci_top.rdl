////////////////////////////////////////////////////////////////
// MCI Registers

`ifndef MCI_TOP_RDL
`define MCI_TOP_RDL

`include "mci_reg.rdl"
`include "trace_buffer_csr.rdl"
`include "mcu_mbox_csr.rdl"

addrmap mci_top {
    desc="Address Map for Caliptra Register Space";

    mci_reg mci_reg @ 0x0000_0000;
    
    trace_buffer_csr mcu_trace_buffer_csr @ 0x0001_0000;

    mem {name="MCU ROM Patch SRAM";
         desc="Dedicated SRAM holding an MCU ROM patch. Writable by MCU LSU only while the LC state is TEST_LOCKED, TEST_UNLOCKED or DEV, UDS is not provisioned and Caliptra core is in reset. Readable/executable by MCU LSU/IFU only after a patch was loaded this power cycle. Max size is 2MB but is configurable by integration team (MCU_ROM_PATCH_SRAM_SIZE_KB).
               [br]Caliptra Access: -
               [br]MCU      Access: RW*
               [br]SOC Access:      -";
         memwidth=32;
         mementries=524288;
         sw=rw;
    } external mcu_rom_patch_sram @ 0x20_0000;
    
    mcu_mbox_csr mcu_mbox0_csr @ 0x0040_0000;
    
    mcu_mbox_csr mcu_mbox1_csr @ 0x0080_0000;

    mem {name="MCU SRAM";
         desc="Mailbox SRAM for Caliptra direct-mode accesses. Accessible by either MCU or Caliptra depending on the security configuration. Max size is 2MB but is configurable by integration team.
               [br]Caliptra Access: RW*
               [br]MCU      Access: RW*
               [br]SOC Access:      -";
         memwidth=32;
         mementries=524288;
         sw=rw;
    } external mcu_sram @ 0xC0_0000;

};

`endif // mci_top.rdl
